@page
@model Comedores.Web.Pages.EmployeesModel
@{ViewData["Title"]="Empleados";ViewData["BodyClass"]="employees-page";var exists=Model.Employee!=null;}
<div class="employee-admin-heading"><div><p class="eyebrow">CATÁLOGO DEL PERSONAL</p><h1>Empleados y fotografías</h1></div><p>Alta · Modificación · Baja</p></div>
@if(Model.Message!=null){<p class="notice" role="status">@Model.Message</p>}
<form method="get" class="filters employee-search"><div><label for="Number">Número de empleado</label><input name="Number" id="Number" value="@Model.Number" inputmode="numeric" maxlength="5" pattern="[0-9]{1,5}" required autocomplete="off"/></div><button>Consultar</button><button type="button" class="secondary" id="new-employee">Nuevo</button></form>
<div class="employee-admin" data-exists="@(exists?"true":"false")" data-editing="@(!ViewData.ModelState.IsValid?"true":"false")" data-photo-url="@Url.Page("/Employees","Photo",new{number=Model.Data.Number})">
<section class="panel camera-panel"><h2>Fotografía del empleado</h2><div class="camera-frame"><img id="saved-photo" alt="Fotografía del empleado" hidden="@(!exists)"/><video id="camera-preview" autoplay playsinline muted hidden></video><img id="captured-photo" alt="Fotografía pendiente de guardar" hidden/><p id="camera-placeholder">Consulta o guarda al empleado para agregar su fotografía.</p></div>
<label for="camera-device">Cámara</label><select id="camera-device" disabled><option value="">Cámara predeterminada</option></select>
<div class="camera-actions"><button type="button" id="start-camera" disabled="@(!exists)">Encender</button><button type="button" id="capture-photo" disabled>Capturar</button><button type="button" id="stop-camera" class="secondary" disabled>Apagar</button></div>
<details class="photo-file-option"><summary>Seleccionar archivo JPEG</summary><label for="photo-file">Fotografía (máximo 5 MB)</label><input id="photo-file" type="file" accept="image/jpeg" disabled="@(!exists)"/></details>
<form method="post" asp-page-handler="Photo" id="photo-form" enctype="multipart/form-data"><input type="hidden" name="employeeNumber" value="@Model.Data.Number"/><button id="save-photo" disabled>Guardar fotografía</button></form>
<p id="camera-status" role="status" aria-live="polite">La fotografía se guarda por separado de los datos.</p></section>
<section class="panel"><form method="post" asp-page-handler="Save" id="employee-form"><div asp-validation-summary="All" role="alert"></div><input type="hidden" asp-for="Original"/><input type="hidden" name="operation" id="employee-operation" value="@(exists?"update":"create")"/>
<fieldset id="employee-fields" disabled><legend>Datos del empleado</legend><div class="employee-fields-grid"><div><label asp-for="Data.Number">Número de empleado</label><input asp-for="Data.Number" inputmode="numeric" pattern="[0-9]{1,5}" maxlength="5" required readonly="@(exists)"/></div><div class="full-field"><label asp-for="Data.Name">Nombre completo (nombre y apellidos)</label><input asp-for="Data.Name" maxlength="150" required/></div><div><label asp-for="Data.Area">Área</label><input asp-for="Data.Area" maxlength="500" required/></div><div><label asp-for="Data.Position">Puesto</label><input asp-for="Data.Position" maxlength="150" required/></div><div class="full-field"><label asp-for="Data.WorkSchedule">Horario laboral</label><input asp-for="Data.WorkSchedule" maxlength="150" required/></div><label class="check-field"><input asp-for="Data.SpecialShift"/>Turno especial</label><label class="check-field"><input asp-for="Data.Active"/>Activo</label></div></fieldset>
<div class="employee-admin-actions"><button id="save-employee" disabled>Guardar datos</button><button type="button" id="edit-employee" class="secondary" disabled="@(!exists)">Modificar</button><button type="button" id="deactivate-employee" class="secondary" disabled="@(Model.Employee?.Active!=true)">Dar de baja</button><a class="button-link secondary" asp-page="/Employees">Limpiar / Cancelar</a><a class="button-link secondary" asp-page="/Index">Salir</a></div></form>
<p id="employee-mode" role="status">@(exists?(Model.Employee!.Active==true?"Consulta: empleado activo. Selecciona Modificar para editar sus datos.":"Consulta: empleado de baja. Puedes reactivarlo con Modificar y Activo."):"Consulta un número o selecciona Nuevo para registrar un empleado.")</p>
<form method="post" asp-page-handler="Deactivate" id="deactivate-form"><input type="hidden" name="Original" value="@Model.Original"/><input type="hidden" name="employeeNumber" value="@Model.Data.Number"/></form>
</section></div>
<dialog id="deactivate-dialog" class="registration-dialog" aria-labelledby="deactivate-title"><h2 id="deactivate-title">Dar de baja al empleado</h2><p>Se desactivará su acceso a servicios. Su historial y fotografía se conservarán. ¿Deseas continuar?</p><form method="dialog" class="dialog-actions"><button value="cancel" class="secondary" autofocus>Cancelar</button><button value="confirm">Confirmar baja</button></form></dialog>
@section Scripts{<script src="~/js/employee-number.js" asp-append-version="true"></script><script src="~/js/employees.js" asp-append-version="true"></script>}
