@page
@model FeedbackModel
@{ViewData["Title"]="Tu opinión cuenta";ViewData["BodyClass"]="feedback-page";}
<section class="module-banner feedback-banner"><div><p class="eyebrow">SICOM · ESCUCHAMOS A NUESTRA GENTE</p><h1>Tu opinión cuenta</h1><p>Quejas, sugerencias y reconocimientos para mejorar tu comedor.</p></div><span class="feedback-banner-icon" aria-hidden="true">☏</span></section>
<div class="feedback-capture panel">
<p>Escribe tu número de empleado, selecciona el tipo y el tema, y comparte tu mensaje.</p>
@if(!Model.Manual){<p>Comedor: <strong>@Model.RoomName</strong></p>}
<form method="post" id="feedback-form">
<div asp-validation-summary="All" class="notice" role="alert"></div>
<input type="hidden" asp-for="RequestId"/>
@if(Model.Manual){<label asp-for="RoomId">Comedor</label><select asp-for="RoomId" required><option value="">Selecciona comedor</option>@foreach(var room in Model.Rooms){<option value="@room.Id">@room.Name</option>}</select>}
<label asp-for="Number">Número de empleado</label><input asp-for="Number" inputmode="numeric" maxlength="5" pattern="[0-9]{1,5}" autocomplete="off" required autofocus/>
<div id="feedback-employee" class="feedback-employee" role="status" aria-live="polite" hidden><div class="feedback-avatar"><img id="feedback-employee-photo" alt="Fotografía del empleado" hidden/><span>Sin foto</span></div><strong id="feedback-employee-name"></strong></div>
<label asp-for="Kind">Tipo de comentario</label><select asp-for="Kind" required><option value="">Selecciona una opción</option>@foreach(var kind in FeedbackService.Kinds){<option>@kind</option>}</select>
<label asp-for="Topic">¿Sobre qué es tu comentario?</label><select asp-for="Topic" required><option value="">Selecciona el tema</option>@foreach(var topic in FeedbackService.Topics){<option>@topic</option>}</select>
<label asp-for="Message">Cuéntanos qué pasó o qué podemos mejorar</label><textarea asp-for="Message" rows="7" minlength="10" maxlength="500" required placeholder="Escribe tu mensaje aquí…"></textarea>
<p class="export-help">Entre 10 y 500 caracteres. Tu comentario será atendido por coordinación y administración. El número proporcionado identifica al comensal; no solicita su contraseña.</p>
<button type="submit">Enviar comentario</button>
</form></div>
@if(!string.IsNullOrEmpty(Model.Notice)){<dialog id="feedback-received" class="registration-dialog" aria-labelledby="feedback-received-title"><h2 id="feedback-received-title">Comentario recibido</h2><p>@Model.Notice</p><form method="dialog" class="dialog-actions"><button autofocus>Aceptar</button></form></dialog>}
@section Scripts{<script src="~/js/employee-number.js" asp-append-version="true"></script><script src="~/js/feedback.js" asp-append-version="true"></script>}
