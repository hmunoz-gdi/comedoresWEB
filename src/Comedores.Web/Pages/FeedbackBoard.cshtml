@page
@model FeedbackBoardModel
@{ViewData["Title"]="Atención al comensal";ViewData["BodyClass"]="feedback-board-page";}
<section class="module-banner feedback-banner"><div><p class="eyebrow">CALIDAD DEL SERVICIO · COORDINACIÓN</p><h1>Atención al comensal</h1><p>Escuchar, atender y mejorar. Cada opinión tiene seguimiento.</p></div></section>
<form method="get" class="filters feedback-filters"><div><label asp-for="From">Desde</label><input asp-for="From" type="date"/></div><div><label asp-for="To">Hasta</label><input asp-for="To" type="date"/></div><div><label asp-for="RoomId">Comedor</label><select asp-for="RoomId"><option value="">Todos</option>@foreach(var room in Model.Rooms){<option value="@room.Id">@room.Name</option>}</select></div><div><label asp-for="Kind">Tipo</label><select asp-for="Kind"><option value="">Todos</option>@foreach(var kind in FeedbackService.Kinds){<option>@kind</option>}</select></div><div><label asp-for="Topic">Tema</label><select asp-for="Topic"><option value="">Todos</option>@foreach(var topic in FeedbackService.Topics.Append(FeedbackService.LegacyTopic)){<option>@topic</option>}</select></div><div><label asp-for="Status">Estado</label><select asp-for="Status"><option value="">Todos</option>@foreach(var status in FeedbackService.Statuses){<option>@status</option>}</select></div><div><label asp-for="Number">Número de empleado</label><input asp-for="Number" inputmode="numeric" maxlength="5" pattern="[0-9]{1,5}"/></div><button>Consultar</button></form>
<div asp-validation-summary="All" class="notice" role="alert"></div>
<div class="feedback-metrics"><article><span>COMENTARIOS</span><strong>@Model.Total</strong><small>Según los filtros</small></article>@foreach(var status in FeedbackService.Statuses){<article><span>@status.ToUpperInvariant()</span><strong>@Model.ByStatus.GetValueOrDefault(status)</strong><small>Para dar seguimiento</small></article>}</div>
<p class="export-help">Todos los indicadores corresponden a los filtros consultados.</p>
<div class="panel feedback-distribution"><h2>La voz del comensal</h2>@foreach(var kind in FeedbackService.Kinds){var count=Model.ByKind.GetValueOrDefault(kind);var percent=Model.Total==0?0:(int)Math.Round(100d*count/Model.Total);<div class="feedback-chart-row"><span>@kind</span><div class="feedback-chart-track" role="meter" aria-label="@kind" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent"><span style="width:@(percent)%"></span></div><strong>@count</strong></div>}</div>
<div class="panel feedback-distribution"><h2>¿Sobre qué nos comentan?</h2>@foreach(var topic in FeedbackService.Topics.Append(FeedbackService.LegacyTopic)){var count=Model.ByTopic.GetValueOrDefault(topic);var percent=Model.Total==0?0:(int)Math.Round(100d*count/Model.Total);<div class="feedback-chart-row feedback-topic-row"><span>@topic</span><div class="feedback-chart-track" role="meter" aria-label="@topic" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent"><span style="width:@(percent)%"></span></div><strong>@count</strong></div>}</div>
@if(ModelState.IsValid){<a id="export-feedback" class="button-link secondary" asp-page-handler="Csv" asp-route-From="@Model.From.ToString("yyyy-MM-dd")" asp-route-To="@Model.To.ToString("yyyy-MM-dd")" asp-route-RoomId="@Model.RoomId" asp-route-Kind="@Model.Kind" asp-route-Topic="@Model.Topic" asp-route-Status="@Model.Status" asp-route-Number="@Model.Number">Exportar CSV / Excel</a>}
<p class="export-help">Identificación declarada por número de empleado; no autentica por sí sola la autoría del mensaje. El nombre corresponde al catálogo al recibirlo.</p>
<div class="table-wrap"><table><thead><tr><th>Folio</th><th>Fecha CDMX</th><th>Comedor</th><th>Número</th><th>Nombre en catálogo</th><th>Tipo</th><th>Tema</th><th>Estado</th><th>Atención</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.Folio</td><td>@MealService.Local(row.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td><td>@Model.RoomName(row.DiningRoomId)</td><td>@row.EmployeeNumber</td><td>@row.EmployeeName</td><td>@row.Kind</td><td>@row.Topic</td><td><span class="feedback-status">@row.Status</span></td><td><a asp-page="/FeedbackDetail" asp-route-id="@row.Id">Abrir folio</a></td></tr>}</tbody></table></div>
@if(Model.Rows.Count==0&&ModelState.IsValid){<p class="notice">No hay comentarios con estos filtros.</p>}
<nav class="audit-pagination" aria-label="Páginas de comentarios"><span>Página @Model.PageNumber de @Model.Pages</span>@foreach(var pageNumber in new[]{Model.PageNumber-1,Model.PageNumber+1}.Where(n=>n>=1&&n<=Model.Pages)){<a asp-route-From="@Model.From.ToString("yyyy-MM-dd")" asp-route-To="@Model.To.ToString("yyyy-MM-dd")" asp-route-RoomId="@Model.RoomId" asp-route-Kind="@Model.Kind" asp-route-Topic="@Model.Topic" asp-route-Status="@Model.Status" asp-route-Number="@Model.Number" asp-route-PageNumber="@pageNumber">@(pageNumber<Model.PageNumber?"← Anterior":"Siguiente →")</a>}</nav>
