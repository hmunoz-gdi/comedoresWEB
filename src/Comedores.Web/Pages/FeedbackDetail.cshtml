@page
@model FeedbackDetailModel
@{ViewData["Title"]="Atender comentario";}
<p class="eyebrow">ATENCIÓN AL COMENSAL · @Model.Entry.Folio</p><h1>@Model.Entry.Kind</h1><a asp-page="/FeedbackBoard">← Volver al tablero</a>
@if(Model.Notice!=null){<p class="notice" role="status">@Model.Notice</p>}
<section class="panel feedback-detail"><div class="feedback-detail-meta"><strong>@Model.Entry.Folio</strong><span>@Model.RoomName</span><time>@MealService.Local(Model.Entry.CreatedAt).ToString("dd/MM/yyyy HH:mm:ss")</time><span class="feedback-status">@Model.Entry.Status</span></div><p>Número proporcionado: <strong>@Model.Entry.EmployeeNumber</strong> · @Model.Entry.EmployeeName</p><p class="feedback-body">@Model.Entry.Message</p><small>Recibido desde la sesión de @Model.Entry.ReceivedBy. Identificación del comensal declarada por número.</small></section>
<section class="panel feedback-detail"><h2>Registrar atención</h2><form method="post" id="feedback-followup"><div asp-validation-summary="All" class="notice" role="alert"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><label asp-for="Status">Estado</label><select asp-for="Status">@foreach(var status in FeedbackService.Statuses){<option>@status</option>}</select><label asp-for="Note">Nota de atención / acciones realizadas</label><textarea asp-for="Note" rows="5" minlength="5" maxlength="3000" required></textarea><button>Guardar atención</button></form></section>
<section class="panel feedback-detail"><h2>Historial de atención</h2>@if(Model.History.Count==0){<p>Aún no hay notas de atención.</p>}@foreach(var item in Model.History){<article class="feedback-history-item"><strong>@item.Actor</strong><time>@MealService.Local(item.OccurredAt).ToString("dd/MM/yyyy HH:mm:ss")</time><p>@item.PreviousStatus → @item.Status</p><p class="feedback-body">@item.Note</p></article>}</section>
