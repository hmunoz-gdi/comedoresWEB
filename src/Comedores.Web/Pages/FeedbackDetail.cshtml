@page
@model FeedbackDetailModel
@{ViewData["Title"]="Atender comentario";}
<p class="eyebrow">ATENCIÓN AL COMENSAL · @Model.Entry.Folio</p><h1>@Model.Entry.Kind</h1><a asp-page="/FeedbackBoard">← Volver al tablero</a>
@if(Model.Notice!=null){<p class="notice" role="status">@Model.Notice</p>}
<section class="panel feedback-detail"><div class="feedback-detail-meta"><strong>@Model.Entry.Folio</strong><span>@Model.RoomName</span><span>Tema: <strong>@Model.Entry.Topic</strong></span><time>@MealService.Local(Model.Entry.CreatedAt).ToString("dd/MM/yyyy HH:mm:ss")</time><span class="feedback-status" data-status="@Model.Entry.Status">@Model.Entry.Status</span></div><div class="feedback-employee"><div class="feedback-avatar"><img data-employee-photo src="@Url.Page("/Feedback","Photo",new{number=Model.Entry.EmployeeNumber})" alt="Fotografía de @Model.Entry.EmployeeName" hidden/><span>Sin foto</span></div><p>Número proporcionado: <strong>@Model.Entry.EmployeeNumber</strong> · @Model.Entry.EmployeeName</p></div><p class="feedback-body">@Model.Entry.Message</p><small>Recibido desde la sesión de @Model.Entry.ReceivedBy. Identificación del comensal declarada por número.</small></section>
<section class="panel feedback-detail"><h2>Registrar atención</h2><form method="post" id="feedback-followup"><div asp-validation-summary="All" class="notice" role="alert"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><label asp-for="Status">Estado</label><select asp-for="Status">@foreach(var status in FeedbackService.Statuses){<option>@status</option>}</select><label asp-for="Note">Nota de atención / acciones realizadas</label><textarea asp-for="Note" rows="5" minlength="5" maxlength="3000" required></textarea><button>Guardar atención</button></form></section>
<section class="panel feedback-detail"><h2>Historial de atención</h2>@if(Model.History.Count==0){<p>Aún no hay notas de atención.</p>}@foreach(var item in Model.History){<article class="feedback-history-item"><strong>@item.Actor</strong><time>@MealService.Local(item.OccurredAt).ToString("dd/MM/yyyy HH:mm:ss")</time><p><span class="feedback-status" data-status="@item.PreviousStatus">@item.PreviousStatus</span> → <span class="feedback-status" data-status="@item.Status">@item.Status</span></p><p class="feedback-body">@item.Note</p></article>}</section>

@section Scripts{<script src="~/js/feedback.js" asp-append-version="true"></script>}
