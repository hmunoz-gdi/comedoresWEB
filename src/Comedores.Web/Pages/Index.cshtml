@page
@model IndexModel
@{ViewData["Title"]="Inicio";}
<section class="airport-hero"><div><p class="eyebrow">AICM · SERVICIOS AL PERSONAL</p><h1>Un gran equipo.<br/>Un servicio a su altura.</h1><p>La operación del aeropuerto comienza con su gente.<br/>Gestiona los servicios de alimentación desde un solo lugar.</p>@if(AccessProfiles.Services(User)){<a class="hero-action" asp-page="/Register">Registrar servicio <span aria-hidden="true">→</span></a>}</div><div class="hero-caption">AVIACIÓN + ALIMENTACIÓN<span>Conectados por el servicio</span></div></section>
<div class="section-heading"><div><p class="eyebrow">OPERACIÓN DIARIA</p><h2>Todo listo para comenzar</h2></div><span>Control de servicios de alimentación</span></div>
<div class="cards dashboard-cards">@if(AccessProfiles.Services(User)){<a class="card" asp-page="/Register"><span class="card-icon dining-card-icon" aria-hidden="true"><img src="~/images/comedor.svg" alt="" width="28" height="28"/></span><h2>Registrar servicio</h2><p>Consulta al empleado, verifica su fotografía y registra su consumo.</p><span>Abrir registro →</span></a>}@if(AccessProfiles.Reports(User)){<a class="card" asp-page="/Reports"><span class="card-icon" aria-hidden="true">▤</span><h2>Reporte de servicios</h2><p>Consulta los registros por fecha, comedor y categoría del personal.</p><span>Consultar reporte →</span></a>}@if(AccessProfiles.Employees(User)){<a class="card" asp-page="/Employees"><h2>Catálogo de empleados</h2><p>Altas, modificaciones, bajas y fotografías del personal.</p><span>Administrar empleados →</span></a>}@if(User.IsInRole(AccessProfiles.Admin)){<a class="card" asp-page="/Users"><h2>Usuarios y perfiles</h2><p>Asigna a cada cuenta sus funciones autorizadas.</p><span>Administrar usuarios →</span></a>}</div>
