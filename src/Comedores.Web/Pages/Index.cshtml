@page
@model IndexModel
@{ViewData["Title"]="Inicio";}
<section class="dining-hero" aria-labelledby="dining-title">
 <div class="dining-hero-copy"><p class="eyebrow"><span></span> AICM · SERVICIOS DE ALIMENTACIÓN</p>
 <h1 id="dining-title">El bienestar<br/>se sirve <em>a la mesa.</em></h1>
 <p class="dining-intro">Cuidamos a quienes hacen posible cada jornada.<br/>Un espacio para atender, alimentar y servir mejor.</p>
 @if(AccessProfiles.Services(User)){<a class="hero-action" asp-page="/Register"><img src="~/images/comedor.svg" alt="" width="22" height="22"/>Registrar servicio <span aria-hidden="true">→</span></a>}
 <div class="dining-hero-tags"><span>Atención al personal</span><span>Servicio diario</span><span>Gestión de comedores</span></div></div>
 <div class="dining-photo-caption"><span class="dining-caption-line"></span><p>ALIMENTAMOS A NUESTRO EQUIPO<strong>Cada servicio cuenta.</strong></p></div>
</section>
<div class="section-heading"><div><p class="eyebrow">OPERACIÓN DIARIA</p><h2>Todo listo para comenzar</h2></div><span>Tu operación, en un solo lugar</span></div>
<div class="cards dashboard-cards dining-dashboard">@if(AccessProfiles.Services(User)){<a class="card" asp-page="/Register"><span class="card-icon dining-card-icon" aria-hidden="true"><img src="~/images/comedor.svg" alt="" width="28" height="28"/></span><h2>Registrar servicio</h2><p>Consulta al empleado, verifica su fotografía y registra su consumo.</p><span>Abrir registro →</span></a>}@if(AccessProfiles.Reports(User)){<a class="card" asp-page="/Reports"><span class="card-icon" aria-hidden="true">▤</span><h2>Reporte de servicios</h2><p>Consulta los registros por fecha, comedor y categoría del personal.</p><span>Consultar reporte →</span></a>}@if(AccessProfiles.Employees(User)){<a class="card" asp-page="/Employees"><span class="card-icon" aria-hidden="true">♙</span><h2>Catálogo de empleados</h2><p>Altas, modificaciones, bajas y fotografías del personal.</p><span>Administrar empleados →</span></a>}@if(User.IsInRole(AccessProfiles.Admin)){<a class="card" asp-page="/Users"><span class="card-icon" aria-hidden="true">⚿</span><h2>Usuarios y perfiles</h2><p>Asigna a cada cuenta sus funciones autorizadas.</p><span>Administrar usuarios →</span></a>}</div>

<section class="dining-community" aria-labelledby="community-title">
 <div class="dining-community-photo"><img src="~/images/comedor-personal.webp" asp-append-version="true" width="1672" height="941" loading="lazy" alt="Personas compartiendo una comida y conversando con alegría en un comedor industrial moderno"/><span>UN ESPACIO PARA COMPARTIR</span></div>
 <div class="dining-community-copy"><p class="eyebrow">EL PERSONAL, AL CENTRO</p><h2 id="community-title">Una buena comida.<br/>Un mejor momento.</h2><p>Un lugar para hacer una pausa, compartir la mesa y continuar la jornada con energía.</p><div class="community-signature"><img src="~/images/comedor.svg" alt="" width="32" height="32"/><span>Sistema Integral de Comedores<strong>Al servicio de nuestra gente.</strong></span></div></div>
</section>
