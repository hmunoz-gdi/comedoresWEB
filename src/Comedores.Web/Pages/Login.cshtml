@page
@model LoginModel
@{ViewData["Title"]="Acceso";ViewData["BodyClass"]="login-page";}
<section class="login"><div class="login-logos" aria-label="Identidad institucional"><img src="~/images/grupo-aeroportuario-marina.png" asp-append-version="true" alt="Marina Grupo Aeroportuario" width="1080" height="832"/><img src="~/images/secretaria-marina.png" asp-append-version="true" alt="Marina · Secretaría de Marina" width="1772" height="650"/></div><p class="eyebrow">BIENVENIDO</p><h1>Sistema Integral de Comedores</h1><p>Acceso del personal autorizado</p>@if(Model.Error!=null){<p class="notice" role="alert" hidden="@(Model.AccountLocked||Model.TerminalRejected)">@Model.Error</p>}<form method="post"><label asp-for="Username">Usuario</label><input asp-for="Username" autocomplete="username" required/><label asp-for="Password">Contraseña</label><input asp-for="Password" type="password" autocomplete="current-password" required/><button>Iniciar sesión</button></form><p class="login-help">Por seguridad, la cuenta se bloquea después de 3 intentos fallidos consecutivos.<br/>Mesa de Ayuda del AICM · Extensión <strong>2442</strong>.</p></section>

@if(Model.AccountLocked){<dialog id="account-locked-dialog" class="registration-dialog" aria-labelledby="account-locked-title" aria-describedby="account-locked-instructions">
 <h2 id="account-locked-title">Cuenta bloqueada</h2>
 <div id="account-locked-instructions"><p>Para recuperar el acceso, comunícate con la <strong>Mesa de Ayuda del AICM, extensión 2442</strong>, o solicita la habilitación a:</p><p><strong>hmunoz@aicm.com.mx</strong><br/><strong>mfloreso@aicm.com.mx</strong></p><p>Indica tu usuario y comedor. <strong>No compartas tu contraseña.</strong></p><p>El administrador verificará tu identidad y habilitará la cuenta. Después podrás entrar con tu contraseña habitual.</p></div>
 <form method="dialog" class="dialog-actions"><button id="account-locked-accept" autofocus>Entendido</button></form>
</dialog>}
@if(Model.TerminalRejected){<dialog id="terminal-rejected-dialog" class="registration-dialog" aria-labelledby="terminal-rejected-title" aria-describedby="terminal-rejected-message"><h2 id="terminal-rejected-title">Equipo no autorizado</h2><p id="terminal-rejected-message">@Model.Error</p><form method="dialog" class="dialog-actions"><button id="terminal-rejected-accept" autofocus>Entendido</button></form></dialog>}
@section Scripts{<script src="~/js/login.js" asp-append-version="true"></script>}
