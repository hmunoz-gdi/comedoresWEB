@page
@model LoginModel
@{ViewData["Title"]="Acceso";ViewData["BodyClass"]="login-page";}
<section class="login"><div class="login-logos" aria-label="Identidad institucional"><img src="~/images/grupo-aeroportuario-marina.png" asp-append-version="true" alt="Marina Grupo Aeroportuario" width="1080" height="832"/><img src="~/images/secretaria-marina.png" asp-append-version="true" alt="Marina · Secretaría de Marina" width="1772" height="650"/></div><p class="eyebrow">BIENVENIDO</p><h1>Sistema Integral de Comedores</h1><p>Acceso del personal autorizado</p>@if(Model.Error!=null){<p class="notice" role="alert">@Model.Error</p>}<form method="post"><label asp-for="Username">Usuario</label><input asp-for="Username" autocomplete="username" required/><label asp-for="Password">Contraseña</label><input asp-for="Password" type="password" autocomplete="current-password" required/><button>Iniciar sesión</button></form><p class="login-help">Por seguridad, la cuenta se bloquea después de 3 intentos fallidos consecutivos.<br/>Mesa de Ayuda del AICM · Extensión <strong>2442</strong>.</p></section>
