@page
@model PickupModel
@{ViewData["Title"]="Recogida para compañeros";ViewData["BodyClass"]="pickup-page";}
<section data-service-counter-url="@Url.Page("/Register","ServiceTotal")" data-counter-room-select="pickup-room" data-counter-type-select="pickup-type" data-counter-manual="@(Model.Coordinator?"true":"false")" data-counter-output="pickup-service-total" class="module-banner pickup-module-banner" aria-labelledby="pickup-title"><div><p class="eyebrow">SICOM · SERVICIOS POR ENCARGO</p><h1 id="pickup-title">Recoger para compañeros</h1><p class="module-description">Un responsable. Varios comensales. Una sola confirmación.</p></div><div class="pickup-context"><div><span>COMEDOR</span><strong id="pickup-room-label">@(Model.Coordinator?"Selecciona comedor":Model.Room)</strong></div><div><span>@(Model.Coordinator?"SERVICIO SELECCIONADO":"SERVICIO AL ABRIR")</span><strong id="pickup-service-label">@(Model.Coordinator?"Selecciona servicio":Model.Service)</strong></div><div class="service-total"><span>SERVICIOS REGISTRADOS</span><strong id="pickup-service-total" aria-live="polite">—</strong><small id="pickup-service-total-status">Incluye encargos de compañeros</small></div></div></section>
<div class="module-toolbar"><a asp-page="/Register" class="module-back">← Registro individual</a><span>Responsable + gafetes de sus compañeros</span></div>
@if(Model.Simulated){<aside><strong>MODO DE PRUEBA:</strong> se aplican la fecha o IP simuladas configuradas al arrancar.</aside>}
<div id="pickup-app" data-lookup="@Url.Page("/Register","Lookup")" data-save="@Url.Page("/Pickup","Save")" data-request="@Guid.NewGuid()">
<form id="pickup-token" method="post">@Html.AntiForgeryToken()</form>
<p id="pickup-status" class="notice" role="status" hidden></p>
<div class="pickup-grid"><section class="panel pickup-capture">
<h2><span class="pickup-step">01</span> Quien recoge</h2><form id="collector-form"><label for="collector-number">Número del responsable</label><input id="collector-number" inputmode="numeric" maxlength="5" pattern="[0-9]{1,5}" required autocomplete="off"/><button>Identificar responsable</button></form>
<p id="collector-name"></p><label class="check-field"><input id="include-own" type="checkbox" checked/>Incluir también su comida</label>
<h2><span class="pickup-step">02</span> Agregar compañeros</h2><form id="member-form"><label for="member-number">Número del compañero</label><input id="member-number" inputmode="numeric" maxlength="5" pattern="[0-9]{1,5}" required autocomplete="off" disabled/><button id="member-add" disabled>Agregar · Enter</button></form>
<p class="export-help">Cada Enter agrega un comensal. Ctrl+Enter registra el grupo completo. No se guarda nada hasta confirmar.</p>
@if(Model.Coordinator){<label for="pickup-room">Comedor</label><select id="pickup-room"><option value="">Selecciona comedor</option>@foreach(var room in Model.Rooms){<option value="@room.Id">@room.Name</option>}</select><label for="pickup-type">Servicio</label><select id="pickup-type"><option value="">Selecciona tipo</option><option value="DYN">DYN · Desayuno</option><option value="COM">COM · Comida</option><option value="CEN">CEN · Cena</option></select>}else{<p class="pickup-validation-note">Se valida comedor, horario y cada gafete al confirmar.</p>}
</section><section class="panel pickup-summary"><p class="eyebrow">VERIFICACIÓN DEL COMENSAL</p><div class="pickup-preview"><img id="pickup-photo" alt="Fotografía del último empleado consultado" hidden/><p id="pickup-person">Verifica el nombre y fotografía al agregar cada gafete.</p></div><div class="pickup-total"><div><span>SERVICIOS POR REGISTRAR</span><h2>Tu grupo está aquí</h2></div><strong id="pickup-count">0</strong></div><ul id="pickup-list"></ul><div class="dialog-actions"><button id="pickup-clear" class="secondary" type="button">Limpiar grupo</button><button id="pickup-save" type="button" disabled>Registrar grupo</button></div></section></div>
</div>
<dialog id="pickup-dialog" class="registration-dialog" aria-labelledby="pickup-dialog-title"><h2 id="pickup-dialog-title"></h2><p id="pickup-dialog-message"></p><div id="pickup-warnings"></div><form method="dialog" class="dialog-actions"><button value="cancel" id="pickup-cancel" class="secondary" autofocus>Cancelar</button><button value="continue" id="pickup-accept">Continuar</button></form></dialog>
@section Scripts{<script src="~/js/service-counter.js" asp-append-version="true"></script><script src="~/js/pickup.js" asp-append-version="true"></script>}
