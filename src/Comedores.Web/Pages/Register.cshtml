@page
@model RegisterModel
@{ViewData["Title"]="Registrar servicio";}
<p class="eyebrow">REGISTRO DE COMENSALES</p><h1>Registrar servicio</h1><p>Comedor: <strong>@(Model.Room??"Equipo sin configurar")</strong></p>
@if(Model.Message!=null){<p class="notice" role="status">@Model.Message</p>}
<form method="get" class="filters"><div><label for="Number">Número de empleado</label><input id="Number" name="Number" value="@Model.Number" maxlength="10" required autofocus/></div><button>Consultar</button></form>
@if(Model.Employee!=null){var e=Model.Employee;<section class="panel employee-card"><div class="employee-photo">@if(Model.HasPhoto){<img src="@Url.Page("/Register", "Photo", new {number=e.Number})" alt="Fotografía de @e.Name" width="200" height="240"/>}else{<div class="photo-placeholder"><span aria-hidden="true">👤</span><p>Sin fotografía</p></div>}</div><div class="employee-info"><h2>@(string.IsNullOrWhiteSpace(e.Name)?"Nombre no disponible en el catálogo":e.Name)</h2><dl><dt>Número</dt><dd>@e.Number</dd><dt>Área</dt><dd>@e.Area</dd><dt>Puesto</dt><dd>@e.Position</dd><dt>Horario laboral</dt><dd>@e.WorkSchedule</dd><dt>Turno especial</dt><dd>@(e.SpecialShift?"Sí":"No")</dd><dt>Servicios hoy, todos los comedores</dt><dd>@Model.TodayCount</dd></dl><form method="post"><input type="hidden" asp-for="Number"/><input type="hidden" asp-for="RequestId"/><button disabled="@(Model.Room==null || e.Active!=true)">Registrar servicio</button></form></div></section>}
<aside>Se valida el horario de servicio del comedor. La validación del horario laboral individual está pendiente de definición con RH.</aside>
