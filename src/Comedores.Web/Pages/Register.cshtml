@page
@model RegisterModel
@{ViewData["Title"]="Registrar servicio"; ViewData["BodyClass"]=Model.IsCoordinator?"registration-page registration-coordinator":"registration-page"; var e=Model.Employee;}
<div class="registration-top"><div class="registration-heading"><div><p class="eyebrow">REGISTRO DE COMENSALES</p><h1>Registrar servicio</h1></div><a asp-page="/Pickup" class="pickup-entry pickup-action"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="8" cy="7" r="3"/><path d="M2 20v-2a6 6 0 0 1 12 0v2M16 4a3 3 0 0 1 0 6M18 13a5 5 0 0 1 4 5v2"/></svg><span>Recoger para compañeros</span><span aria-hidden="true">→</span></a></div>
<section class="server-banner" data-manual="@(Model.IsCoordinator?"true":"false")" id="server-banner" aria-label="Hora, comedor y servicio" data-clock-url="@Url.Page("/Register","Clock")" data-epoch="@Model.ServerEpoch" data-simulated="@(Model.IsSimulated?"true":"false")">
 <div class="server-banner-top"><span class="banner-operation-label">CONTROL DE SERVICIOS</span><span id="clock-status" role="status">Sincronizando con el servidor…</span><button type="button" id="clock-motion" class="secondary" aria-pressed="false">Pausar marquesina</button></div>
 <div class="server-banner-main"><span class="banner-field-label">HORA · CIUDAD DE MÉXICO</span><time id="server-clock" aria-live="off">@Model.ServerClock</time><time id="server-date" aria-live="off">@Model.ServerDate</time></div>
 <div class="server-banner-room"><span class="banner-field-label">COMEDOR</span><strong id="current-room">@(Model.IsCoordinator?Model.CoordinatorRooms.FirstOrDefault(r=>r.Id==Model.CoordinatorRoomId)?.Name??"Selecciona comedor":Model.Room??"Sin asignar")</strong><span class="banner-field-note">@(Model.IsCoordinator?"Comedor seleccionado":"Ubicación del servicio")</span></div>
 <div class="server-banner-service"><span class="banner-field-label">@(Model.IsCoordinator?"SERVICIO SELECCIONADO":"SERVICIO VIGENTE")</span><strong id="current-service">@(Model.IsCoordinator?(MealTypes.IsKnown(Model.SelectedServiceType??"")?MealTypes.Name(Model.SelectedServiceType!):"Selecciona servicio"):Model.CurrentService)</strong><span class="banner-field-note">@(Model.IsCoordinator?"Coordinador · selección manual":"Según el horario del comedor")</span></div>
 <div class="server-marquee" aria-hidden="true"><span> SISTEMA INTEGRAL DE COMEDORES · AL SERVICIO DE NUESTRA GENTE · REGISTRO ÁGIL DE COMENSALES </span></div>
</section></div>
@if(Model.IsSimulated){<aside role="status"><strong>MODO DE PRUEBA: HORA SIMULADA.</strong> Los registros guardarán esta hora. @if(Model.IsIpSimulated){<span>IP simulada: @Model.EffectiveIp.</span>}</aside>}
@if(!Model.IsSimulated&&Model.IsIpSimulated){<aside role="status"><strong>IP SIMULADA DE PRUEBA:</strong> @Model.EffectiveIp. El comedor se identifica con esta IP de prueba.</aside>}
<p id="registration-message" class="notice" role="status" aria-live="polite" hidden="@(Model.Message==null)">@Model.Message</p>
<div class="registration-workspace"><form method="get" class="filters capture-box" id="lookup-form" data-lookup-url="@Url.Page("/Register","Lookup")">
 <div>
  <label for="Number">Número de empleado</label>
  <input id="Number" name="Number" value="@Model.Number" type="text" inputmode="numeric" pattern="[0-9]{1,5}" maxlength="5" title="Solo números, máximo 5 dígitos" aria-describedby="number-help" required autofocus autocomplete="off"/>
  <small id="number-help">Número + Enter: consultar · Enter otra vez: registrar · Esc: siguiente comensal.</small>
 </div>
 <button id="lookup-button">Consultar</button>
 @if(Model.IsCoordinator){<div class="coordinator-options"><div><label for="CoordinatorRoomId">Comedor del servicio</label><select asp-for="CoordinatorRoomId" form="registration-form" required><option value="">Selecciona comedor</option>@foreach(var room in Model.CoordinatorRooms){<option value="@room.Id">@room.Name</option>}</select></div><div><label for="SelectedServiceType">Tipo de servicio *</label><select asp-for="SelectedServiceType" form="registration-form" required><option value="">Selecciona tipo</option><option value="DYN">DYN · Desayuno</option><option value="COM">COM · Comida</option><option value="CEN">CEN · Cena</option></select></div></div><p class="coordinator-note">Coordinador: tipo manual, sin restricción de horario.</p>}
 <details class="registration-note"><summary>Reglas del servicio</summary><p>Se aplica el horario del comedor. Si repites desayuno, comida o cena se solicita confirmación antes de guardar.</p></details>
</form>
<div class="registration-watermark" aria-hidden="true"><img src="~/images/grupo-aeroportuario-marina.png" asp-append-version="true" alt="" width="1080" height="832"/><p>Sistema Integral<br/><strong>de Comedores</strong></p><span>AICM · SERVICIOS AL PERSONAL</span></div>
<section class="panel employee-card" id="employee-card" data-number="@e?.Number" hidden="@(e==null)">
 <div class="employee-photo">
  <img id="employee-photo" src="@(Model.HasPhoto?Url.Page("/Register","Photo",new {number=e!.Number}):null)" alt="Fotografía del empleado" width="200" height="240" hidden="@(!Model.HasPhoto)"/>
  <div id="photo-placeholder" class="photo-placeholder" hidden="@(Model.HasPhoto)"><span aria-hidden="true">👤</span><p id="photo-label">Sin fotografía</p></div>
 </div>
 <div class="employee-info">
  <p id="employee-stage" class="eyebrow">COMENSAL CONSULTADO</p>
  <h2 id="employee-name">@(string.IsNullOrWhiteSpace(e?.Name)?"Nombre no disponible en el catálogo":e.Name)</h2>
  <dl>
   <div><dt>Número</dt><dd id="employee-number">@e?.Number</dd></div>
   <div class="detail-wide"><dt>Área</dt><dd id="employee-area">@e?.Area</dd></div>
   <div class="detail-wide"><dt>Puesto</dt><dd id="employee-position">@e?.Position</dd></div>
   <div class="detail-wide"><dt>Horario laboral</dt><dd id="employee-schedule">@e?.WorkSchedule</dd></div>
   <div><dt>Turno especial</dt><dd id="employee-special">@(e?.SpecialShift==true?"Sí":"No")</dd></div>
   <div><dt>Servicios hoy · todos los comedores</dt><dd id="employee-count">@Model.TodayCount</dd></div>
  </dl>
  <form method="post" id="registration-form" data-quick-url="@Url.Page("/Register","Quick")">

   <input type="hidden" name="Number" id="registration-number" value="@Model.Number"/>
   <input type="hidden" asp-for="RequestId"/>
   <button id="register-button" disabled="@(!Model.CanRegister)">Registrar servicio · Enter</button>
  </form>
 </div>
</section></div>
<dialog id="not-found-dialog" class="registration-dialog" data-show="@(Model.EmployeeNotFound?"true":"false")" aria-labelledby="not-found-title" aria-describedby="not-found-message">
 <h2 id="not-found-title">Empleado no encontrado</h2>
 <p id="not-found-message">Empleado no encontrado en el catálogo. Revisa el número de empleado.</p>
 <form method="dialog" class="dialog-actions"><button id="not-found-accept" autofocus>Aceptar</button></form>
</dialog>
<dialog id="success-dialog" class="registration-dialog" aria-labelledby="success-title" aria-describedby="success-message">
 <h2 id="success-title">Servicio aplicado</h2>
 <p id="success-message"></p>
 <form method="dialog" class="dialog-actions"><button id="success-accept" autofocus>Aceptar</button></form>
</dialog>
<dialog id="hours-dialog" class="registration-dialog" data-show="@((e?.Active==true && Model.OutsideHours)?"true":"false")" aria-labelledby="hours-title" aria-describedby="hours-message">
 <h2 id="hours-title">Fuera de horario</h2>
 <p id="hours-message">Fuera del horario de servicio de este comedor.</p>
 <form method="dialog" class="dialog-actions"><button id="hours-accept" autofocus>Entendido</button></form>
</dialog>
<dialog id="repeat-dialog" class="registration-dialog" aria-labelledby="repeat-title" aria-describedby="repeat-message">
 <h2 id="repeat-title">Servicio repetido en este horario</h2>
 <p id="repeat-message"></p>
 <form method="dialog" class="dialog-actions">
  <button value="cancel" id="cancel-repeat" class="secondary" autofocus>Cancelar</button>
  <button value="continue" id="continue-repeat">Continuar</button>
 </form>
</dialog>
@section Scripts {
 <script src="~/js/server-clock.js" asp-append-version="true"></script>
 <script src="~/js/employee-number.js" asp-append-version="true"></script>
 <script src="~/js/quick-registration.js" asp-append-version="true"></script>
}
