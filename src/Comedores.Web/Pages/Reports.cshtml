@page
@model ReportsModel
@{ViewData["Title"]="Reporte de servicios";}
<p class="eyebrow">CONSULTA E IMPRESIÓN</p><h1>Reporte del servicio de comedores</h1>
<form method="get" class="filters"><div><label asp-for="From">Fecha inicial</label><input asp-for="From" type="date"/></div><div><label asp-for="To">Fecha final</label><input asp-for="To" type="date"/></div><div><label asp-for="RoomId">Comedor</label><select asp-for="RoomId"><option value="">GLOBAL</option>@foreach(var room in Model.Rooms){<option value="@room.Id">@room.Name</option>}</select></div><div><label asp-for="Category">Personal</label><select asp-for="Category"><option value="">Todos</option>@foreach(var cat in new[]{"Operativo","Mando","Corporativo"}){<option>@cat</option>}</select></div><div class="employee-report-filter"><label asp-for="EmployeeSearch">Empleado · número o nombre</label><input asp-for="EmployeeSearch" maxlength="150" placeholder="Ej. 42833 o nombre" type="search"/></div><button>Consultar</button></form>
<div asp-validation-summary="All" class="notice"></div>
@if(!string.IsNullOrEmpty(Model.Message)){<p class="notice" role="status">@Model.Message</p>}
<p>Periodo: @Model.From.ToString("dd/MM/yyyy") a @Model.To.ToString("dd/MM/yyyy") · @Model.Rows.Count consumos · <strong>@Model.Rows.Count(x=>x.IsTakeaway) servicios para llevar</strong></p><p>Resumen por empleado, fecha y comedor. Se conservan todas las horas de los servicios repetidos. Para llevar identifica los encargos de compañeros; la comida propia del responsable no se marca como encargo. Sin importes ni calificación de cobro.</p><div class="report-actions"><button type="button" id="print-report" class="secondary">Imprimir / guardar PDF</button>
@if(ModelState.IsValid){<a class="button-link" asp-page-handler="Csv" asp-route-format="resumen" asp-route-From="@Model.From.ToString("yyyy-MM-dd")" asp-route-To="@Model.To.ToString("yyyy-MM-dd")" asp-route-RoomId="@Model.RoomId" asp-route-Category="@Model.Category" asp-route-EmployeeSearch="@Model.EmployeeSearch" id="export-summary">Exportar resumen CSV / Excel</a><a class="button-link secondary" asp-page-handler="Csv" asp-route-format="detalle" asp-route-From="@Model.From.ToString("yyyy-MM-dd")" asp-route-To="@Model.To.ToString("yyyy-MM-dd")" asp-route-RoomId="@Model.RoomId" asp-route-Category="@Model.Category" asp-route-EmployeeSearch="@Model.EmployeeSearch" id="export-detail">Exportar detalle CSV / Excel</a>}
</div><p class="export-help">Consulta primero los filtros deseados. CSV es un archivo de texto que puedes abrir en Excel.</p>
<div class="table-wrap"><table><thead><tr><th>Empleado</th><th>Nombre</th><th>Puesto</th><th>Fecha</th><th>Comedor</th><th>Desayuno · horas</th><th>Comida · horas</th><th>Cena · horas</th><th>Adicionales</th><th>Turno especial</th><th>Recogió · número</th><th>Responsable de recogida</th><th>Servicios para llevar</th></tr></thead><tbody>
@foreach(var group in Model.Rows.GroupBy(x=>new {x.EmployeeId,x.ServiceDate,x.DiningRoomId,x.SpecialShift,x.CollectedByNumber})){
var first=group.First();
<tr><td>@first.Employee.Number</td><td>@first.EmployeeName</td><td>@first.Position</td><td>@first.ServiceDate.ToString("dd/MM/yyyy")</td><td>@first.DiningRoom.Name</td>
@foreach(var type in new[]{"DYN","COM","CEN"}){var meals=group.Where(x=>x.Type==type).OrderBy(x=>x.OccurredAt).ToList();<td><strong>@meals.Count</strong> · @string.Join(", ",meals.Select(x=>MealService.Local(x.OccurredAt).ToString("HH:mm:ss")))</td>}
<td>@group.Count(x=>x.DailySequence>1)</td><td>@(first.SpecialShift?"Sí":"No")</td><td>@(first.CollectedByNumber??"—")</td><td>@(first.CollectedByName??"—")</td><td>@group.Count(x=>x.IsTakeaway)</td></tr>
}
</tbody></table></div>
<details open="@Model.ShowDetails"><summary>Ver detalle de cada consumo</summary><div class="table-wrap"><table><thead><tr><th>Empleado</th><th>Fecha</th><th>Hora</th><th>Servicio</th><th>Comedor</th><th>N.º del día</th><th>Tipo</th><th>Turno especial</th><th>Recogió · número</th><th>Responsable de recogida</th><th>Para llevar</th>@if(Model.CanDelete){<th>Acciones</th>}</tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.Employee.Number</td><td>@row.ServiceDate.ToString("dd/MM/yyyy")</td><td>@MealService.Local(row.OccurredAt).ToString("HH:mm:ss")</td><td>@MealTypes.Name(row.Type)</td><td>@row.DiningRoom.Name</td><td>@row.DailySequence</td><td>@(row.DailySequence>1?"Adicional":"Primero")</td><td>@(row.SpecialShift?"Sí":"No")</td><td>@(row.CollectedByNumber??"—")</td><td>@(row.CollectedByName??"—")</td><td>@(row.IsTakeaway?"Sí":"No")</td>@if(Model.CanDelete){<td><button type="button" class="delete-consumption secondary" data-id="@row.Id" data-description="@row.Employee.Number · @row.EmployeeName · @MealTypes.Name(row.Type) · @row.ServiceDate.ToString("dd/MM/yyyy") · @MealService.Local(row.OccurredAt).ToString("HH:mm:ss")">Eliminar</button></td>}</tr>}</tbody></table></div></details>
@if(!Model.Rows.Any() && ModelState.IsValid){<p class="notice">No se encontraron servicios con estos filtros.</p>}
@if(Model.CanDelete){
<dialog id="delete-consumption-dialog" class="registration-dialog" aria-labelledby="delete-consumption-title"><h2 id="delete-consumption-title">Eliminar registro de servicio</h2><p id="delete-consumption-description"></p><p>Se descontará del contador y los reportes. Se conservará el historial de auditoría.</p><form method="post" asp-page-handler="Delete" id="delete-consumption-form"><input type="hidden" name="consumptionId" id="delete-consumption-id"/><input type="hidden" asp-for="From" id="delete-filter-From"/><input type="hidden" asp-for="To" id="delete-filter-To"/><input type="hidden" asp-for="RoomId" id="delete-filter-RoomId"/><input type="hidden" asp-for="Category" id="delete-filter-Category"/><input type="hidden" asp-for="EmployeeSearch" id="delete-filter-EmployeeSearch"/><label for="delete-reason">Motivo de eliminación</label><textarea id="delete-reason" name="reason" minlength="5" maxlength="300" required></textarea><div class="dialog-actions"><button type="button" id="cancel-deletion" class="secondary" autofocus>Cancelar</button><button type="submit">Confirmar eliminación</button></div></form></dialog>
}
@section Scripts {<script src="~/js/report.js" asp-append-version="true"></script>}
