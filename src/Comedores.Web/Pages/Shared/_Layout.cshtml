@{var authenticated=User.Identity?.IsAuthenticated==true; var current=ViewContext.RouteData.Values["page"]?.ToString();}
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Comedores</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body class="@(authenticated ? "app-shell" : "access-shell") @ViewData["BodyClass"]">
<header class="app-sidebar"><a class="institutional-brand" asp-page="/Index" aria-label="AICM · Inicio"><img class="airport-logo" src="~/images/grupo-aeroportuario-marina.png" asp-append-version="true" alt="Marina Grupo Aeroportuario" width="1080" height="832"/><img class="marina-logo" src="~/images/secretaria-marina.png" asp-append-version="true" alt="Marina · Secretaría de Marina" width="1772" height="650"/><span>AICM</span></a><div class="system-identity"><svg class="dining-mark" viewBox="0 0 64 64" aria-hidden="true"><circle cx="34" cy="32" r="19"/><circle cx="34" cy="32" r="12"/><path d="M6 9v13c0 6 8 6 8 0V9M10 9v46M59 9c-5 7-6 15-2 20h3M60 9v46"/></svg><p>Sistema Integral<span>de Comedores</span></p></div>
@if(authenticated){<p class="sidebar-label">ESPACIO DE TRABAJO</p><nav aria-label="Menú principal"><a asp-page="/Index" aria-current="@(current=="/Index"?"page":null)"><span aria-hidden="true">⌂</span>Inicio</a><a asp-page="/Register" aria-current="@(current=="/Register"?"page":null)"><span aria-hidden="true">＋</span>Registrar servicio</a><a asp-page="/Employees" aria-current="@(current=="/Employees"?"page":null)"><span aria-hidden="true">♙</span>Empleados</a><a asp-page="/Reports" aria-current="@(current=="/Reports"?"page":null)"><span aria-hidden="true">▤</span>Reportes</a><form method="post" asp-page="/Login" asp-page-handler="Logout"><button class="secondary">Cerrar sesión</button></form></nav><div class="sidebar-bottom"><span class="connection-dot"></span> Alimentamos al equipo<br/><small>que conecta a México.</small></div>}
</header><main>@RenderBody()</main><footer>Sistema Integral de Comedores · Entorno de desarrollo · Sin cálculo de cobros</footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
