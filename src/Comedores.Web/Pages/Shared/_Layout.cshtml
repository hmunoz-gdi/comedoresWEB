@{var authenticated=User.Identity?.IsAuthenticated==true; var current=ViewContext.RouteData.Values["page"]?.ToString();}
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Comedores</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body class="@(authenticated ? "app-shell" : "access-shell") @ViewData["BodyClass"]">
<header class="app-sidebar"><a class="brand" asp-page="/Index"><span class="brand-symbol" aria-hidden="true">✈︎</span><span class="brand-name">AICM<small>Sistema Integral<br/>de Comedores</small></span></a>
@if(authenticated){<p class="sidebar-label">ESPACIO DE TRABAJO</p><nav aria-label="Menú principal"><a asp-page="/Index" aria-current="@(current=="/Index"?"page":null)"><span aria-hidden="true">⌂</span>Inicio</a><a asp-page="/Register" aria-current="@(current=="/Register"?"page":null)"><span aria-hidden="true">＋</span>Registrar servicio</a><a asp-page="/Reports" aria-current="@(current=="/Reports"?"page":null)"><span aria-hidden="true">▤</span>Reportes</a><form method="post" asp-page="/Login" asp-page-handler="Logout"><button class="secondary">Cerrar sesión</button></form></nav><div class="sidebar-bottom"><span class="connection-dot"></span> Alimentamos al equipo<br/><small>que conecta a México.</small></div>}
</header><main>@RenderBody()</main><footer>Sistema Integral de Comedores · Entorno de desarrollo · Sin cálculo de cobros</footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
