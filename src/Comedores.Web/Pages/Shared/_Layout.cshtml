<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Comedores</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><header><a class="brand" asp-page="/Index">AICM <span>Sistema Integral de Comedores</span></a>@if(User.Identity?.IsAuthenticated==true){<nav><a asp-page="/Index">Inicio</a><a asp-page="/Register">Registrar servicio</a><a asp-page="/Reports">Reportes</a><form method="post" asp-page="/Login" asp-page-handler="Logout"><button class="secondary">Cerrar sesión</button></form></nav>}</header><main>@RenderBody()</main><footer>Desarrollo · Datos ficticios · Sin cálculo de cobros</footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
