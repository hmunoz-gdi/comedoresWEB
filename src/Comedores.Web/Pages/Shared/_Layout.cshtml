@{var authenticated=User.Identity?.IsAuthenticated==true; var current=ViewContext.RouteData.Values["page"]?.ToString();}
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Comedores</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body class="@(authenticated ? "app-shell" : "access-shell") @ViewData["BodyClass"]">
@if(ViewData["BodyClass"]?.ToString()!="login-page"){<header class="app-sidebar"><a class="institutional-brand" asp-page="/Index" aria-label="AICM · Inicio"><img class="airport-logo" src="~/images/grupo-aeroportuario-marina.png" asp-append-version="true" alt="Marina Grupo Aeroportuario" width="1080" height="832"/><span>AICM</span></a><div class="system-identity"><svg class="system-aircraft-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M32 5c-3 0-5 4-5 8v10L7 36v6l20-6v12l-7 6v4l12-3 12 3v-4l-7-6V36l20 6v-6L37 23V13c0-4-2-8-5-8Z"/></svg><p>Sistema Integral<span>de Comedores</span></p></div>
@if(authenticated){<p class="sidebar-label">ESPACIO DE TRABAJO</p><nav aria-label="Menú principal"><a asp-page="/Index" aria-current="@(current=="/Index"?"page":null)"><span aria-hidden="true">⌂</span>Inicio</a>@if(AccessProfiles.Services(User)){<a asp-page="/Register" aria-current="@(current=="/Register"?"page":null)"><svg class="nav-service-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><circle cx="34" cy="32" r="19"/><circle cx="34" cy="32" r="12"/><path d="M6 9v13c0 6 8 6 8 0V9M10 9v46M59 9c-5 7-6 15-2 20h3M60 9v46"/></svg>Registrar servicio</a>}@if(AccessProfiles.Employees(User)){<a asp-page="/Employees" aria-current="@(current=="/Employees"?"page":null)"><span aria-hidden="true">♙</span>Empleados</a>}@if(AccessProfiles.Reports(User)){<a asp-page="/Reports" aria-current="@(current=="/Reports"?"page":null)"><span aria-hidden="true">▤</span>Reportes</a>}@if(User.IsInRole(AccessProfiles.Admin)){<a asp-page="/Users" aria-current="@(current=="/Users"?"page":null)"><span aria-hidden="true">⚿</span>Usuarios y perfiles</a>}<form method="post" asp-page="/Login" asp-page-handler="Logout"><button class="secondary">Cerrar sesión</button></form></nav><div class="sidebar-bottom"><span class="connection-dot"></span> Alimentamos al equipo<br/><small>que conecta a México.</small></div>}
</header>}<main>@RenderBody()</main><footer>Sistema Integral de Comedores · Entorno de desarrollo · Sin cálculo de cobros</footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
