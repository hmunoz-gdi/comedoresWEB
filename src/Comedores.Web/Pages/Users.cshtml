@page
@model Comedores.Web.Pages.UsersModel
@{ViewData["Title"]="Usuarios y perfiles";}
<p class="eyebrow">ADMINISTRACIÓN DEL SISTEMA</p><h1>Usuarios y perfiles</h1>
@if(Model.Message!=null){<p class="notice" role="status">@Model.Message</p>}
<form method="post" class="panel"><label asp-for="Username">Usuario</label><input asp-for="Username" maxlength="100" required autocomplete="off" readonly="@(Model.ExistingSelected)"/><label asp-for="Profile">Perfil</label><select asp-for="Profile" disabled="@(Model.SelectedAdministrator)"><option value="">Selecciona perfil</option><option value="Operador">Operador · Servicios en horario y reportes de su comedor</option><option value="Catalogo">Catálogo · Empleados y fotografías</option><option value="Coordinador">Coordinador · Servicios sin horario y todos los reportes</option></select><label asp-for="RoomId">Comedor (obligatorio para Operador)</label><select asp-for="RoomId" disabled="@(Model.SelectedAdministrator)"><option value="">Selecciona comedor</option>@foreach(var room in Model.Rooms){<option value="@room.Id">@room.Name</option>}</select><label asp-for="Password">Contraseña (sólo para crear una cuenta nueva)</label><input asp-for="Password" type="password" autocomplete="new-password" disabled="@(Model.ExistingSelected)"/><p>Al menos 12 caracteres, incluyendo mayúsculas, minúsculas, números y símbolos.</p><div class="dialog-actions"><a class="button-link secondary" asp-page="/Users">Nuevo / Limpiar</a><button name="operation" value="create" disabled="@(Model.ExistingSelected)">Crear usuario</button><button name="operation" value="profile" class="secondary" disabled="@(Model.SelectedAdministrator)">Cambiar perfil</button></div></form>
@if(Model.ExistingSelected){<p role="status" id="selected-user-status">Cuenta seleccionada: <strong>@Model.Username</strong> · @(Model.SelectedLocked?"Bloqueada":"Habilitada"). @(Model.SelectedAdministrator?"La cuenta administrativa conserva sus perfiles; no se modifica desde este formulario.":"Modifica el perfil o comedor y pulsa Cambiar perfil. La contraseña actual no se muestra ni se cambia.")</p>}
@if(Model.ExistingSelected && Model.CanResetPasswords){
<section class="panel" aria-labelledby="reset-password-title">
<h2 id="reset-password-title">Cambiar contraseña de @Model.Username</h2>
<p>Asigna una contraseña nueva. La contraseña anterior no se puede consultar. Esta acción no desbloquea la cuenta ni cambia sus perfiles o comedor.</p>
<form method="post" asp-page-handler="ResetPassword" id="reset-password-form">
<input type="hidden" name="accountName" value="@Model.Username"/>
<label for="admin-password">Tu contraseña actual de demo</label><input id="admin-password" name="adminPassword" type="password" autocomplete="current-password" required maxlength="256"/>
<label for="new-password">Nueva contraseña del usuario</label><input id="new-password" name="newPassword" type="password" autocomplete="new-password" required minlength="12" maxlength="256"/>
<label for="confirm-password">Confirmar nueva contraseña</label><input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" required minlength="12" maxlength="256"/>
<p>Al menos 12 caracteres, incluyendo mayúsculas, minúsculas, números y símbolos.</p>
<label for="reset-reason">Motivo / folio (sin contraseñas)</label><input id="reset-reason" name="resetReason" required minlength="5" maxlength="300" autocomplete="off"/>
<div class="dialog-actions"><button>Cambiar contraseña</button></div>
</form></section>
}
<div class="table-wrap"><table><thead><tr><th>Usuario</th><th>Perfiles asignados</th><th>Comedor asignado</th><th>Estado</th><th>Desbloqueo</th></tr></thead><tbody>@foreach(var account in Model.Accounts){<tr><td><a asp-page="/Users" asp-route-SelectedUser="@account.Name" class="select-user">@account.Name</a></td><td>@account.Roles</td><td>@account.Room</td><td>@(account.Locked?"Bloqueada":"Habilitada")</td><td>@if(account.Locked){<form method="post" asp-page-handler="Unlock" class="unlock-form"><input type="hidden" name="accountName" value="@account.Name"/><label>Motivo / folio de atención<input name="reason" required minlength="5" maxlength="300" placeholder="Identidad verificada, folio…"/></label><button>Desbloquear cuenta</button></form>}</td></tr>}</tbody></table></div>

<h2>Últimos 50 movimientos de seguridad</h2><div class="table-wrap"><table><thead><tr><th>Fecha y hora (Ciudad de México)</th><th>Cuenta</th><th>Acción</th><th>Responsable</th><th>Motivo / folio</th></tr></thead><tbody>@foreach(var entry in Model.SecurityEvents){<tr><td>@MealService.Local(entry.OccurredAt).ToString("dd/MM/yyyy HH:mm:ss")</td><td>@entry.Account</td><td>@entry.Action</td><td>@entry.Actor</td><td>@entry.Reason</td></tr>}</tbody></table></div>
