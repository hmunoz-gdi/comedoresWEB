@page
@model Comedores.Web.Pages.UsersModel
@{ViewData["Title"]="Usuarios y perfiles";}
<p class="eyebrow">ADMINISTRACIÓN DEL SISTEMA</p><h1>Usuarios y perfiles</h1>
@if(Model.Message!=null){<p class="notice" role="status">@Model.Message</p>}
<form method="post" class="panel"><label asp-for="Username">Usuario</label><input asp-for="Username" maxlength="100" required autocomplete="off"/><label asp-for="Profile">Perfil</label><select asp-for="Profile"><option value="Operador">Operador · Servicios en horario y reportes de su comedor</option><option value="Catalogo">Catálogo · Empleados y fotografías</option><option value="Coordinador">Coordinador · Servicios sin horario y todos los reportes</option></select><label asp-for="RoomId">Comedor (obligatorio para Operador)</label><select asp-for="RoomId"><option value="">Selecciona comedor</option>@foreach(var room in Model.Rooms){<option value="@room.Id">@room.Name</option>}</select><label asp-for="Password">Contraseña (sólo para crear una cuenta nueva)</label><input asp-for="Password" type="password" autocomplete="new-password"/><p>Al menos 12 caracteres, incluyendo mayúsculas, minúsculas, números y símbolos.</p><div class="dialog-actions"><button name="operation" value="create">Crear usuario</button><button name="operation" value="profile" class="secondary">Cambiar perfil</button></div></form>
<div class="table-wrap"><table><thead><tr><th>Usuario</th><th>Perfiles asignados</th><th>Comedor asignado</th></tr></thead><tbody>@foreach(var account in Model.Accounts){<tr><td>@account.Name</td><td>@account.Roles</td><td>@account.Room</td></tr>}</tbody></table></div>
